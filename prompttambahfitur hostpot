GET /hotspot/sessions | POST /hotspot/sessions | PUT /hotspot/sessions/:id | DELETE /hotspot/sessions/:id
POST /hotspot/sessions/:id/connect | POST /hotspot/sessions/:id/ping
GET /hotspot/users (query: session, profile, comment, search, page) | POST /hotspot/users | DELETE /hotspot/users/:id
POST /hotspot/users/generate (payload: server, profile, qty, mode=up|vc, length, prefix, timeLimit, dataLimitMB, additionalComment)
GET /hotspot/active (query: session, server) | DELETE /hotspot/active/:id
GET /hotspot/profiles | POST /hotspot/profiles | PUT /hotspot/profiles/:id | DELETE /hotspot/profiles/:id
GET /hotspot/schedulers | POST /hotspot/schedulers | PUT /hotspot/schedulers/:id | DELETE /hotspot/schedulers/:id
GET /hotspot/reports/selling (query: session, day, month, prefix, profile) | DELETE /hotspot/reports/selling (by day|month|all)
